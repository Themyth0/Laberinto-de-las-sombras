[ext_resource type="Texture2D" uid="uid://dp7n4bxg563a6" path="res://free-underwater-enemies-pixel-art-character-pack/1/Walk.png" id="1_ke6sm"]
[ext_resource type="Texture2D" uid="uid://bx03w5npkcxcp" path="res://free-underwater-enemies-pixel-art-character-pack/1/Idle.png" id="2_s6d1f"]

[sub_resource type="GDScript" id="GDScript_ke6sm"]
script/source = "extends CharacterBody2D
@onready var sprite= $AnimatedSprite2D
@export var velocidad = 50.0
var player = null
var persiguiendo = false

func _physics_process(delta):
	
	if persiguiendo and player:
		var direccion = (player.global_position - global_position).normalized()
		velocity.x = direccion.x * velocidad
		actualizar_orientacion(player.global_position)
	else:
		velocity.x = move_toward(velocity.x, 0, velocidad) 

	
	if not is_on_floor():
		velocity.y += get_gravity().y * delta

	
	actualizar_animaciones()

	move_and_slide()

func actualizar_animaciones():
	
	if abs(velocity.x) > 1:
		sprite.play(\"Caminar\")
	else:
		sprite.play(\"Parado\")
	
	move_and_slide()
	
	
	if velocity.x != 0:
		actualizar_orientacion(player.global_position)
	
func actualizar_orientacion(objetivo_pos: Vector2):
	
	if objetivo_pos.x < global_position.x:
		sprite.flip_h = true  
	else:
		sprite.flip_h = false 


func _on_area_2d_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"Jugador\"):
		
		player = body
		persiguiendo = true

func _on_area_2d_body_exited(body: Node2D) -> void:
	if body == player:
		persiguiendo = false
		player = null


func _on_area_2d_2_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"Jugador\"):
		if body.has_method(\"recibir_dano\"):
			body.recibir_dano()
"

